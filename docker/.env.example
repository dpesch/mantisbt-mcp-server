# ==============================================================================
# MantisBT MCP Server - Environment Configuration Template
# Copy this file to .env and adjust the values accordingly.
# ==============================================================================
COMPOSE_PROJECT_NAME=mantis-mcp

# Required: MantisBT instance REST API URL
MANTIS_BASE_URL=https://your-mantis.example.com/api/rest

# Optional: Default / fallback MantisBT API token.
# In multi-user LAN mode, users can provide their own MantisBT token per request
# via "Authorization: Bearer <user_token>" in their MCP client configuration.
# MANTIS_API_KEY=

# Optional: Server access token.
# If set, clients can use this token (or their own MantisBT key).
# If unset, clients MUST provide their own MantisBT API key via Authorization: Bearer <token>.
# MCP_HTTP_TOKEN=

# Host network binding (set to 0.0.0.0 or your LAN IP to expose on the network)
HOST_IP=127.0.0.1
PORT=3000
# MCP_HTTP_HOST=0.0.0.0

# Optional MantisBT settings
# Set to true if your server lacks URL rewriting (uses /api/rest/index.php/)
# MANTIS_USE_INDEX_PHP=false

# Cache configuration (seconds)
# MANTIS_CACHE_TTL=3600

# Optional semantic search settings
# MANTIS_SEARCH_ENABLED=false
# MANTIS_SEARCH_BACKEND=vectra
# MANTIS_SEARCH_THREADS=1

# Optional file upload boundary directory
# MANTIS_UPLOAD_DIR=
